# Dockerfile completo para compilar APK de Android
# Construye todo desde cero incluyendo el frontend y el APK

FROM mingc/android-build-box:latest

# Instalar Node.js 18
RUN apt-get update && apt-get install -y curl ca-certificates gnupg && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_18.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y nodejs && \
    npm install -g pnpm && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Establecer JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

# Directorio de trabajo
WORKDIR /app

# Copiar archivos del proyecto
COPY package.json pnpm-lock.yaml ./
COPY capacitor.config.ts ./
COPY vite.config.ts vite.config.server.ts ./
COPY tsconfig.json ./
COPY tailwind.config.ts postcss.config.js ./
COPY components.json ./
COPY index.html ./
COPY client/ ./client/
COPY server/ ./server/
COPY shared/ ./shared/
COPY public/ ./public/
COPY android/ ./android/

# Instalar dependencias y compilar
RUN pnpm install
RUN pnpm build:client

# Copiar assets al proyecto Android
RUN mkdir -p android/app/src/main/assets/public && \
    cp -r dist/spa/* android/app/src/main/assets/public/ 2>/dev/null || true

# Compilar APK
WORKDIR /app/android
RUN ./gradlew assembleDebug --no-daemon --stacktrace || \
    (echo "=== GRADLE ERROR ===" && \
     echo "Verificando estructura..." && \
     ls -la && \
     cat gradle/wrapper/gradle-wrapper.properties && \
     exit 1)

# El APK estará en app/build/outputs/apk/debug/app-debug.apk
